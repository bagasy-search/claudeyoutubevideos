stic bag. She kept the manual for 30 years after the machine was gone. When I asked my brother why she did that, he said, In case. In case of what? Nobody knew. That is the voice of paper. In case. Here is how I sort them. First, any manual for a machine that is no longer in the house goes immediately.", "words": [{"w": " All", "s": 0.0, "e": 0.26}, {"w": " of", "s": 0.26, "e": 0.48}, {"w": " them,", "s": 0.48, "e": 0.76}, {"w": " almost.", "s": 0.76, "e": 1.84}, {"w": " In", "s": 2.0, "e": 2.12}, {"w": " every", "s": 2.12, "e": 2.56}, {"w": " house", "s": 2.56, "e": 2.84}, {"w": " in", "s": 2.84, "e": 3.04}, {"w": " America,", "s": 3.04, "e": 3.72}, {"w": " there", "s": 3.72, "e": 3.8}, {"w": " is", "s": 3.8, "e": 3.98}, {"w": " a", "s": 3.98, "e": 4.1}, {"w": " drawer", "s": 4.1, "e": 4.42}, {"w": " of", "s": 4.42, "e": 4.74}, {"w": " instruction", "s": 4.74, "e": 5.26}, {"w": " books.", "s": 5.26, "e": 6.28}, {"w": " The", "s": 6.36, "e": 6.42}, {"w": " blender,", "s": 6.42, "e": 7.3}, {"w": " the", "s": 7.3, "e": 7.42}, {"w": " microwave,", "s": 7.42, "e": 8.54}, {"w": " the", "s": 8.54, "e": 8.58}, {"w": " television", "s": 8.58, "e": 9.18}, {"w": " you", "s": 9.18, "e": 9.42}, {"w": " replaced", "s": 9.42, "e": 9.9}, {"w": " in", "s": 9.9, "e": 10.12}, {"w": " 2009,", "s": 10.12, "e": 11.12}, {"w": " the", "s": 11.9, "e": 12.0}, {"w": " garage", "s": 12.0, "e": 12.48}, {"w": " door", "s": 12.48, "e": 12.78}, {"w": " opener", "s": 12.78, "e": 13.14}, {"w": " from", "s": 13.14, "e": 13.4}, {"w": " the", "s": 13.4, "e": 13.56}, {"w": " house", "s": 13.56, "e": 13.82}, {"w": " you", "s": 13.82, "e": 13.98}, {"w": " sold.", "s": 13.98, "e": 14.36}, {"w": " I", "s": 14.88, "e": 15.0}, {"w": " counted", "s": 15.0, "e": 15.4}, {"w": " mine", "s": 15.4, "e": 15.7}, {"w": " the", "s": 15.7, "e": 15.86}, {"w": " first", "s": 15.86, "e": 16.14}, {"w": " time.", "s": 16.14, "e": 16.52}, {"w": " 56", "s": 17.14, "e": 17.72}, {"w": " manuals,", "s": 17.72, "e": 18.66}, {"w":