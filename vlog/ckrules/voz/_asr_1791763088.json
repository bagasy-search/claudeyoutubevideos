rs without turning black, and that's why the people who brush it on at the beginning end up with bitter ham. So simmer the brown sugar, honey, mustard, cider vinegar, and a pinch of cloves for two minutes. When the center reads about 120 degrees, take off the foil, raise the oven to 400, and brush on half the glaze. Then the rest, 10 minutes later. Now listen to me for one minute about temperature, because it matters more than any glaze.", "words": [{"w": " church", "s": 0.0, "e": 0.4}, {"w": " supper", "s": 0.4, "e": 0.88}, {"w": " ham,", "s": 0.88, "e": 1.34}, {"w": " the", "s": 1.6, "e": 1.78}, {"w": " Easter", "s": 1.78, "e": 2.22}, {"w": " ham.", "s": 2.22, "e": 2.82}, {"w": " Here", "s": 3.14, "e": 3.38}, {"w": " is", "s": 3.38, "e": 3.7}, {"w": " the", "s": 3.7, "e": 3.92}, {"w": " trick,", "s": 3.92, "e": 4.2}, {"w": " and", "s": 4.52, "e": 4.66}, {"w": " it's", "s": 4.66, "e": 4.92}, {"w": " a", "s": 4.92, "e": 5.08}, {"w": " big", "s": 5.08, "e": 5.26}, {"w": " one.", "s": 5.26, "e": 5.62}, {"w": " The", "s": 5.98, "e": 6.26}, {"w": " glaze", "s": 6.26, "e": 6.56}, {"w": " goes", "s": 6.56, "e": 6.88}, {"w": " on", "s": 6.88, "e": 7.26}, {"w": " in", "s": 7.26, "e": 7.48}, {"w": " the", "s": 7.48, "e": 7.66}, {"w": " last", "s": 7.66, "e": 7.94}, {"w": " 20", "s": 7.94, "e": 8.32}, {"w": " to", "s": 8.32, "e": 8.5}, {"w": " 30", "s": 8.5, "e": 8.82}, {"w": " minutes,", "s": 8.82, "e": 9.32}, {"w": " never", "s": 9.6, "e": 9.98}, {"w": " at", "s": 9.98, "e": 10.22}, {"w": " the", "s": 10.22, "e": 10.5}, {"w": " start.", "s": 10.5, "e": 10.8}, {"w": " You", "s": 11.28, "e": 11.5}, {"w": " put", "s": 11.5, "e": 11.7}, {"w": " that", "s": 11.7, "e": 12.0}, {"w": " ham", "s": 12.0, "e": 12.28}, {"w": " in", "s": 12.28, "e": 12.46}, {"w": " the", "s": 12.46, "e": 12.64}, {"w": " roasting", "s": 12.64, "e": 13.02}, {"w": " pan", "s": 13.02, "e": 13.42}, {"w": " cut", "s": 13.42, "e": 13.76}, {"w": " side", "s": 13.76, "e": 14.08}, {"w": " down,", "s": 14.08, "e":