 and wait two minutes. Six, pour the bean dressing on warm. Seven, save a third of the macaroni dressing. Eight, wring the potatoes dry. Nine, frozen potato puffs go on top. 10, let the hot dish rest. 11, glaze the ham at the end. And 12, vegetables on the bottom, meat on top, and a cup of coffee.", "words": [{"w": " Bernice", "s": 0.0, "e": 0.6}, {"w": " was", "s": 0.6, "e": 0.8}, {"w": " my", "s": 0.8, "e": 1.1}, {"w": " friend", "s": 1.1, "e": 1.34}, {"w": " in", "s": 1.34, "e": 1.52}, {"w": " that", "s": 1.52, "e": 1.76}, {"w": " basement", "s": 1.76, "e": 2.18}, {"w": " kitchen", "s": 2.18, "e": 2.6}, {"w": " for", "s": 2.6, "e": 2.9}, {"w": " 30", "s": 2.9, "e": 3.24}, {"w": " years.", "s": 3.24, "e": 3.76}, {"w": " She", "s": 4.08, "e": 4.22}, {"w": " was", "s": 4.22, "e": 4.48}, {"w": " a", "s": 4.48, "e": 4.72}, {"w": " big", "s": 4.72, "e": 4.94}, {"w": " laughing", "s": 4.94, "e": 5.34}, {"w": " woman", "s": 5.34, "e": 5.76}, {"w": " with", "s": 5.76, "e": 6.06}, {"w": " flour", "s": 6.06, "e": 6.44}, {"w": " on", "s": 6.44, "e": 6.64}, {"w": " her", "s": 6.64, "e": 6.9}, {"w": " glasses,", "s": 6.9, "e": 7.34}, {"w": " and", "s": 7.74, "e": 7.92}, {"w": " she", "s": 7.92, "e": 8.14}, {"w": " used", "s": 8.14, "e": 8.38}, {"w": " to", "s": 8.38, "e": 8.62}, {"w": " say,", "s": 8.62, "e": 8.88}, {"w": " honey,", "s": 8.96, "e": 9.38}, {"w": " the", "s": 9.8, "e": 9.98}, {"w": " good", "s": 9.98, "e": 10.28}, {"w": " cooks", "s": 10.28, "e": 10.56}, {"w": " keep", "s": 10.56, "e": 10.9}, {"w": " one", "s": 10.9, "e": 11.22}, {"w": " secret", "s": 11.22, "e": 11.72}, {"w": " and", "s": 11.72, "e": 12.16}, {"w": " they", "s": 12.16, "e": 12.42}, {"w": " only", "s": 12.42, "e": 12.8}, {"w": " tell", "s": 12.8, "e": 12.98}, {"w": " you", "s": 12.98, "e": 13.16}, {"w": " when", "s": 13.16, "e": 13.34}, {"w": " you", "s": 13.34, "e": 13.62}, {"w": " ask", "s": 13.62, "e": 13.82}, {"w": " the", "s": 13.82, "e": 14.06}, {"w": " right", "s": 14.06, "e": 14.36}, {"w"