         "x": {
          "type": "number",
          "desc": "% width",
          "required": true
         },
         "y": {
          "type": "number",
          "desc": "% height",
          "required": true
         },
         "w": {
          "type": "number",
          "desc": "% width",
          "required": true
         },
         "h": {
          "type": "number",
          "desc": "% height",
          "required": true
         },
         "t": {
          "type": "time",
          "required": true
         }
        },
        "required": false
       }
      }
     },
     "minItems": 1,
     "maxItems": 4,
     "required": true
    }
   },
   "time_props": [
    "photos[].t",
