{
 "version": "lkit-2026-10-12",
 "fps": 30,
 "width": 1920,
 "height": 1080,
 "conventions": {
  "plan_entry": "C shot in the plan: {a, b, kind:'C', c:'<name>', props:{...}}; the Player injects a (s) and d (frames)",
  "times": "EVERY prop of type 'time' is an ABSOLUTE video second (the word in words.json) and must fall inside [a, b) of its shot. For kind=track/overlay, inside the video.",
  "time_paths": "'x' = prop; 'x.y' = object field; 'x[].y' = each element; 'x[][1]' = 2nd value of each tuple",
  "images": "type 'image' = key in KCFG.imgDir (no extension = .png) or a public/ path containing '/'; the file must exist",
  "duration": "min_s/max_s in seconds (b - a); null = not applicable",
  "kinds": {
   "shot": "full shot (kind C)",
   "overlay": "edl.overlays on top of another shot",
   "track": "whole-video track (edl.counts)"
  }
 },
 "components": [
  {
   "name": "ThumbOpen",
   "kind": "shot",
   "file": "src/lkit/items.tsx",
   "use_when": "Opening: the REAL thumbnail held still ~1.5 s, soft fade + slow push into the L photo that matches it; optional kinetic words.",
   "min_s": 4,
   "max_s": 15,
   "props": {
    "thumb": {
     "type": "image",
     "desc": "real thumbnail (th_card.jpg)",
     "required": true
    },
    "k": {
     "type": "image",
     "desc": "L photo matching the thumbnail framing",
     "required": true
    },
    "vid": {
     "type": "boolean",
     "required": false
    },
    "fade": {
     "type": "time",
     "desc": "second the fade starts; default a+1.5",
     "required": false
    },
    "o": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "desc": "[x%, y%] push focus",
     "required": false
    },
    "words": {
     "type": "array",
     "items": {
      "type": "tuple",
      "items": [
       {
        "type": "string"
       },
       {
        "type": "time"
       }
      ]
     },
     "desc": "[[word, second], ...] - each word lands on its second",
     "required": false
    }
   },
   "time_props": [
    "fade",
    "words[][1]"
   ],
   "image_props": [
    "thumb",
    "k"
   ],
   "notes": "Only at second 0. No words ON the thumbnail (words must land after the fade)."
  },
  {
   "name": "ItemCard",
   "kind": "shot",
   "file": "src/lkit/items.tsx",
   "use_when": "Every list item (ITEM n): number, name (struck out at t), INSTEAD: what we used, PAGE tag.",
   "min_s": 6,
   "max_s": 12,
   "props": {
    "n": {
     "type": "number",
     "required": true
    },
    "of": {
     "type": "number",
     "desc": "total, e.g. 13",
     "required": false
    },
    "word": {
     "type": "string",
     "desc": "default ITEM",
     "required": false
    },
    "name": {
     "type": "string",
     "desc": "the modern thing",
     "required": true
    },
    "instead": {
     "type": "string",
     "desc": "what was used instead",
     "required": true
    },
    "page": {
     "type": "string",
     "desc": "'PAGE 20' - the real book page",
     "required": false
    },
    "k": {
     "type": "image",
     "desc": "real photo of the modern thing",
     "required": true
    },
    "k2": {
     "type": "image",
     "desc": "photo of the old way; slides in at t",
     "required": false
    },
    "t": {
     "type": "time",
     "desc": "the word 'instead' (or the replacement)",
     "required": true
    },
    "bed": {
     "type": "image",
     "required": false
    }
   },
   "time_props": [
    "t"
   ],
   "image_props": [
    "k",
    "k2",
    "bed"
   ],
   "notes": ">= 6 s. Put its [a,b] in edl.hide so the ItemCounter steps aside."
  },
  {
   "name": "ItemCounter",
   "kind": "track",
   "file": "src/lkit/items.tsx",
   "use_when": "'ITEM n OF N' badge top-right during EVERY item section.",
   "min_s": null,
   "max_s": null,
   "props": {
    "counts": {
     "type": "array",
     "items": {
      "type": "object",
      "props": {
       "a": {
        "type": "time",
        "required": true
       },
       "b": {
        "type": "time",
        "required": true
       },
       "n": {
        "type": "number",
        "required": true
       }
      }
     },
     "desc": "one span per item; n = the REAL item number",
     "required": true
    },
    "of": {
     "type": "number",
     "required": true
    },
    "word": {
     "type": "string",
     "desc": "ITEM / STEP / THING",
     "required": false
    },
    "hide": {
     "type": "array",
     "items": {
      "type": "tuple",
      "items": [
       {
        "type": "time"
       },
       {
        "type": "time"
       }
      ]
     },
     "required": false
    }
   },
   "time_props": [
    "counts[].a",
    "counts[].b",
    "hide[][0]",
    "hide[][1]"
   ],
   "image_props": [],
   "notes": "Not a shot: goes in edl.counts / edl.of / edl.word / edl.hide; the Player mounts it over the whole video. n must be the real number (no skips, no repeats, increasing)."
  },
  {
   "name": "SwapCard",
   "kind": "shot",
   "file": "src/lkit/items.tsx",
   "use_when": "'What most homes do today' vs 'what we used instead': wipe on the word 'instead'.",
   "min_s": 6,
   "max_s": 12,
   "props": {
    "old": {
     "type": "object",
     "props": {
      "k": {
       "type": "image",
       "required": true
      },
      "txt": {
       "type": "string",
       "required": true
      }
     },
     "required": true
    },
    "neu": {
     "type": "object",
     "props": {
      "k": {
       "type": "image",
       "required": true
      },
      "txt": {
       "type": "string",
       "required": true
      }
     },
     "required": true
    },
    "t": {
     "type": "time",
     "desc": "the word 'instead'",
     "required": true
    },
    "head": {
     "type": "string",
     "desc": "default WHAT WE USED INSTEAD",
     "required": false
    },
    "oldHead": {
     "type": "string",
     "desc": "default MOST HOMES TODAY",
     "required": false
    }
   },
   "time_props": [
    "t"
   ],
   "image_props": [
    "old.k",
    "neu.k"
   ]
  },
  {
   "name": "DropList",
   "kind": "shot",
   "file": "src/lkit/items.tsx",
   "use_when": "An EMPTY shelf/table that fills: each thing drops on ITS word with a hand-written label (pantry jars, tools...).",
   "min_s": 6,
   "max_s": 22,
   "props": {
    "k": {
     "type": "image",
     "desc": "photo of the EMPTY shelf",
     "required": true
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "props": {
       "t": {
        "type": "time",
        "required": true
       },
       "txt": {
        "type": "string",
        "required": true
       },
       "k": {
        "type": "image",
        "desc": "small photo of the thing; without k = kraft label",
        "required": false
       }
      }
     },
     "minItems": 2,
     "maxItems": 8,
     "required": true
    },
    "head": {
     "type": "string",
     "required": false
    },
    "shelfY": {
     "type": "number",
     "desc": "% height where things rest; default 72",
     "required": false
    },
    "x0": {
     "type": "number",
     "desc": "% row start; default 12",
     "required": false
    },
    "x1": {
     "type": "number",
     "desc": "% row end; default 88",
     "required": false
    }
   },
   "time_props": [
    "items[].t"
   ],
   "image_props": [
    "k",
    "items[].k"
   ],
   "notes": "First item should drop <= 1 s after the cut (Opus: 'its first jar drops at once')."
  },
  {
   "name": "GoneList",
   "kind": "shot",
   "file": "src/lkit/items.tsx",
   "use_when": "Recap: photo of a cluttered home; each thing gets a red circle + number on its word, then fades out.",
   "min_s": 8,
   "max_s": 25,
   "props": {
    "k": {
     "type": "image",
     "desc": "real photo full of things (L/N)",
     "required": true
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "props": {
       "t": {
        "type": "time",
        "required": true
       },
       "txt": {
        "type": "string",
        "required": true
       },
       "x": {
        "type": "number",
        "desc": "% width of the center",
        "required": true
       },
       "y": {
        "type": "number",
        "desc": "% height",
        "required": true
       },
       "r": {
        "type": "number",
        "desc": "radius in % width; default 9",
        "required": false
       }
      }
     },
     "minItems": 2,
     "maxItems": 13,
     "required": true
    },
    "head": {
     "type": "string",
     "required": false
    },
    "fade": {
     "type": "number",
     "desc": "seconds until it fades; default 1.2",
     "required": false
    }
   },
   "time_props": [
    "items[].t"
   ],
   "image_props": [
    "k"
   ]
  },
  {
   "name": "CheckScene",
   "kind": "shot",
