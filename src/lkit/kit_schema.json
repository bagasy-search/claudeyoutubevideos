   ],
   "image_props": [
    "k"
   ]
  },
  {
   "name": "PhotoSeq",
   "kind": "shot",
   "file": "src/lkit/items.tsx",
   "use_when": "One shot with 2-4 photos changing on their words (merges short shots); optional red/chalk mark.",
   "min_s": 6,
   "max_s": 14,
   "props": {
    "photos": {
     "type": "array",
     "items": {
      "type": "object",
      "props": {
       "k": {
        "type": "image",
