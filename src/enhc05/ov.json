0, "to": 780, "label": "3 HOURS OF \"FRIENDSHIP\""}, {"k": "big", "a": 644.9, "b": 648.9, "text": "A TRICK WITH LONELINESS", "size": 120, "rev": true}, {"k": "say", "a": 692.2, "b": 697.7, "text": "I'm only looking today. I'm not buying today."}, {"k": "q", "a": 700.22, "b": 705.72, "n": 5, "label": "TELL", "q": "POLITE PEOPLE DON'T WALK OUT", "stamp": "STAND UP", "low": true}, {"k": "lower", "a": 738.82, "b": 744.32, "name": "JUDGE ARTURO PRIETO, 73", "l2": "RETIRED CIRCUIT JUDGE · CORAL GABLES"}, {"k": "quote", "a": 768.5, "b": 773.5, "text": "Thank you for your time, gentlemen. I'll think about it at home.", "who": "JUDGE PRIETO, 2003"}, {"k": "money", "a": 804.12, "b": 808.62, "to": 1100, "label": "LOWER · THE NEXT MORNING", "sub": "for standing up and walking out", "rev": true}, {"k": "say", "a": 836.26, "b": 841.76, "text": "Thank you. I'll think about it at home."}, {"k": "q", "a": 849.84, "b": 855.34, "n": 6, "label": "TELL", "q": "THEY HAVE ALL DAY", "stamp": "TWO HOURS. THEN LEAVE.", "gaps": []}, {"k": "lower", "a": 921.78, "b": 926.78, "name": "OSCAR BERMÚDEZ, 71", "l2": "RETIRED POSTAL CARRIER · WESTCHESTER"}, {"k": "clock", "a": 927.84, "b": 932.84, "from": 870, "to": 1245, "label": "6 HOURS 10 MINUTES"}, {"k": "quote", "a": 938.72, "b": 943.22, "text": "Hector, I came at two-thirty. Just give me the papers, I'll sign whatever.", "who": "MR. BERMÚDEZ, 1997"}, {"k": "say", "a": 952.74, "b": 957.74, "text": "I have two hours today."}, {"k": "say", "a": 971.0, "b": 975.5, "text": "I need my keys back now, please."}, {"k": "say", "a": 983.28, "b": 988.28, "text": "I'll come back tomorrow morning to do the paperwork."}, {"k": "q", "a": 994.72, "b": 1000.72, "n": 7, "label": "TELL", "q": "THE CREDIT APPLICATION", "stamp": "PRICE FIRST", "low": true}, {"k": "big", "a": 1024.06, "b": 1028.56, "text": "AGE IS PROTECTED", "sub": "Equal Credit Opportunity Act", "size": 130, "y": 900}, {"k": "big", "a": 1056.58, "b": 1060.58, "text": "CREDIT LIFE", "sub": "pays the