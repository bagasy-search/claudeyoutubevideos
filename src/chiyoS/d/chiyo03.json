": "Prueba", "a": 327.8333, "b": 338.6667, "txt": "Count to thirty. Then slowly, inner corner to the outside.", "lab": "at your dresser"}, {"k": "Prog", "a": 351.9, "b": 363.5333, "n": 1}, {"k": "Prog", "a": 368.3333, "b": 378.8333, "n": 1}, {"k": "Kin", "a": 381.2333, "b": 384.8, "txt": "the wing of a butterfly", "big": 1}, {"k": "Prog", "a": 381.4333, "b": 384.7333, "n": 1}, {"k": "Prog", "a": 387.9, "b": 393.6667, "n": 1}, {"k": "Prog", "a": 399.5333, "b": 413.8667, "n": 1}, {"k": "Tela", "a": 419.1333, "b": 419.9, "dir": 1}, {"k": "Prog", "a": 429.1667, "b": 431.9667, "n": 2}, {"k": "Prog", "a": 433.6, "b": 439.1333, "n": 2}, {"k": "Palabra", "a": 440.0333, "b": 443.5667, "kan": "むくみ", "rom": "mukumi", "sig": "morning puffiness"}, {"k": "Prog", "a": 441.4, "b": 446.7667, "n": 2}, {"k": "Prog", "a": 449.9, "b": 464.9667, "n": 2}, {"k": "Prueba", "a": 467.8, "b": 471.4, "txt": "Ring fingers. Press, lift, move. Inner corner to the temple.", "lab": "at your dresser"}, {"k": "Prog", "a": 467.8667, "b": 471.1667, "n": 2}, {"k": "Prog", "a": 474.9, "b": 486.4667, "n": 2}, {"k": "Prueba", "a": 489.9, "b": 493.5, "txt": "Inner corner, under the eye, temple, ear. Five times.", "lab": "at your dresser"}, {"k": "Prog", "a": 495.3333, "b": 503.8667, "n": 2}, {"k": "Prog", "a": 506.5, "b": 511.0667, "n": 2}, {"k": "Prog", "a": 515.8, "b": 529.5667, "n": 2}, {"k": "Kin", "a": 529.7333, "b": 530.8667, "txt": "never rub", "big": 1}, {"k": "Prog", "a": 532.9333, "b": 541.5667, "n": 2}, {"k": "Prog", "a": 549.7333, "b": 557.3667, "n": 2}, {"k": "Prog", "a": 564.2667, "b": 580.0667, "n": 2}, {"k": "Prog", "a": 581.8333, "b": 585.5667, "n": 2}, {"k": "Tela", "a": 585.3333, "b": 586.1, "dir": 2}, {"k": "Prog", "a": 595.8333, "b": 610.1667, "n": 3}, {"k": "Prog", "a": 612.4333, "b": 626.6667, "n": 3}, {"k": "Prueba", "a": 621.6333, "b": 628.1333, "txt": "Cold tea bags on closed eyes. Forty seconds. Breathe.", "lab": "at your dresser"}, {"k": "Prog", "a": 629.8, "b": 637.3333, "n": 3},