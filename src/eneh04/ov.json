[{"k": "big", "a": 3.92, "b": 6.72, "text": "40 MIN", "sub": "since you met him", "col": "#ffb257"}, {"k": "money", "a": 11.28, "b": 14.48, "to": 9400, "label": "THE NUMBER UNDER IT", "col": "#ff4a3d", "from": 0}, {"k": "comment", "a": 16.38, "b": 20.98, "text": "\"Just your date of birth and the last four of your Social...\""}, {"k": "stamp", "a": 28.1, "b": 30.3, "text": "ALONE", "col": "#ff4a3d", "rot": -5}, {"k": "tag", "a": 37.74, "b": 40.74, "x": 1060, "y": 460, "text": "THE SECOND OPINION", "sub": "the man who comes after", "col": "#9fd8ff"}, {"k": "big", "a": 44.2, "b": 47.4, "text": "6 THINGS", "sub": "never let them do in your home", "col": "#ff4a3d"}, {"k": "map", "a": 54.78, "b": 59.78, "pins": [{"at": 54.78, "k": "NORRIDGE", "sub": "BUNGALOWS"}, {"at": 57.48, "k": "CICERO", "sub": "TWO-FLATS"}]}, {"k": "chips", "a": 58.62, "b": 62.62, "items": ["WIDOWS", "A PRIEST", "MY OWN SISTER"]}, {"k": "comment", "a": 83.22, "b": 86.42, "text": "\"I know the kid. The salesman.\""}, {"k": "lower", "a": 87.0, "b": 92.0, "name": "ENZO RUSSO", "l2": "45 winters in Chicago basements"}, {"k": "map", "a": 95.68, "b": 107.68, "pins": [{"at": 99.02, "k": "AVONDALE", "sub": "WALT KAMINSKI · 1979"}, {"at": 106.1, "k": "ELMWOOD PARK", "sub": "RUSSO HEATING · 1986"}]}, {"k": "person", "a": 116.68, "b": 120.28, "name": "MARCO", "l2": "MY SON · 44 · RUNS THE COMPANY"}, {"k": "qr", "a": 141.08, "b": 149.58, "page": "cov_ez-set", "name": "DON'T BUY THAT FURNACE", "pg": "3 LITTLE BOOKS"}, {"k": "step", "a": 151.84, "b": 155.64, "n": "1", "tx": "NEVER ALONE IN YOUR BASEMENT"}, {"k": "person", "a": 155.6, "b": 159.6, "name": "CARMELA", "l2": "MY SISTER · 74 · MELROSE PARK"}, {"k": "comment", "a": 207.1, "b": 210.9, "text": "\"Enzo, I didn't want you to think I'm getting old.\""}, {"k": "stamp", "a": 215.76, "b": 218.76, "text": "\"WAIT UPSTAIRS\"", "col": "#ff4a3d", "rot": -5}, {"k": "chips", "a": 229.12, "b": 233.72, "items": ["\"INDUCER MOTOR FAILING\"", "\"HEAT EXCHANGER STRESS\""]}, {"k": "comment", "a": 240.8, "b": 244.6, "text": "\"Let me ask my brother. My brother is in the business.\""}, {"k": "tag", "a": 272.9, "b": 276.3, "pt": "ind", "text": "HOSE OFF", "sub": "pressure switch", "col": "#ff4a3d"}, {"k": "stamp", "a": 284.08, "b": 286.88, "text": "SOMEBODY PULLED IT", "col": "#ff4a3d", "rot": -4}, {"k": "comment", "a": 306.96, "b": 311.16, "text": "\"I've seen techs pull a wire or a hose so the customer calls back scared.\""}, {"k": "money", "a": 316.2, "b": 319.0, "to": 0, "label": "THE HOSE", "col": "#3fd17a", "from": 1800}, {"k": "stamp", "a": 337.3, "b": 339.9, "text": "NOTHING TO SHOW", "col": "#3fd17a", "rot": -4}, {"k": "fridge", "a": 361.02, "b": 365.62, "text": "\"I like to watch. My late husband always did.\""}, {"k": "chips", "a": 365.92, "b": 372.32, "items": ["PANEL ON", "PANEL OPEN", "THE PART HE POINTS AT"]}, {"k": "comment", "a": 394.96, "b": 398.36, "text": "\"Thank you, I'm fine right here.\""}, {"k": "step", "a": 397.04, "b": 400.84, "n": "2", "tx": "KEEP THE OLD PART"}, {"k": "chips", "a": 406.4, "b": 410.6, "items": ["MOTOR", "BOARD", "CAPACITOR", "IGNITER"]}, {"k": "fridge", "a": 416.02, "b": 420.02, "text": "\"I'd like the old part back, please. Leave it on the dryer.\""}, {"k": "map", "a": 430.1, "b": 434.3, "pins": [{"at": 430.1, "k": "OAK PARK", "sub": "THE SCHOOLTEACHER · 2022"}]}, {"k": "inv", "a": 436.44, "b": 442.44, "co": "BLOWER MOTOR · OAK PARK", "rows": [{"at": 436.44, "item": "New blower motor", "v": 1800}], "totalAt": 438.96}, {"k": "stamp", "a": 455.16, "b": 458.16, "text": "2009", "col": "#ffd60a", "rot": -5}, {"k": "stamp", "a": 458.0, "b": 460.6, "text": "THE SAME MOTOR", "col": "#ff4a3d", "rot": -4, "y": 700}, {"k": "money", "a": 482.42, "b": 485.62, "to": 1800, "label": "BACK · DISPUTED", "col": "#3fd17a", "from": 0}, {"k": "big", "a": 490.56, "b": 493.36, "text": "10 YEARS", "sub": "parts warranty · if registered", "col": "#9fd8ff"}, {"k": "comment", "a": 508.4, "b": 512.0, "text": "\"Fine. Show it to me first, and let me take a picture.\""}, {"k": "fridge", "a": 514.42, "b": 518.42, "text": "CUSTOMER WANTS OLD PARTS."}, {"k": "chips", "a": 520.26, "b": 524.06, "items": ["CREDIT CARD ✔", "CASH ✘", "CHECK ✘"]}, {"k": "qr", "a": 525.64, "b": 530.24, "page": "pg_sign25", "name": "DON'T BUY THAT FURNACE", "pg": "BOOK 1 · PAGE 25 · THE OLD PART"}, {"k": "step", "a": 530.16, "b": 533.96, "n": "3", "tx": "NEVER BYPASS A SAFETY"}, {"k": "chips", "a": 545.2, "b": 552.4, "items": ["TOO HOT", "EXHAUST NOT GOING UP", "FLAMES ROLL OUT", "WATER BACKING UP"]}, {"k": "comment", "a": 585.98, "b": 589.58, "text": "\"That'll get you through the night. I'll come back Monday.\""}, {"k": "person", "a": 589.9, "b": 593.3, "name": "WALT KAMINSKI", "l2": "AVONDALE · WINTER 1984"}, {"k": "comment", "a": 605.98, "b": 609.58, "text": "\"It kept shutting off, and the tenants were complaining.\""}, {"k": "big", "a": 626.08, "b": 629.08, "text": "3 FAMILIES", "sub": "sleeping upstairs", "col": "#ff4a3d"}, {"k": "comment", "a": 634.48, "b": 638.08, "text": "\"Enzo, you keep this. So you remember.\""}, {"k": "map", "a": 643.88, "b": 647.88, "pins": [{"at": 644.74, "k": "SKOKIE", "sub": "THE PATELS · LAST SUMMER"}]}, {"k": "comment", "a": 653.02, "b": 656.42, "text": "\"I can jump it so your A/C runs.\""}, {"k": "comment", "a": 660.24, "b": 663.64, "text": "\"And where does the water go then?\""}, {"k": "chips", "a": 679.1, "b": 683.7, "items": ["\"I CAN BYPASS THIS\"", "\"I CAN JUMP THIS\"", "\"JUST FOR TONIGHT\""]}, {"k": "fridge", "a": 685.24, "b": 689.44, "text": "\"Then turn it off, and come back with the part.\""}, {"k": "chips", "a": 704.66, "b": 709.66, "items": ["EXHAUST SMELL", "HEADACHES THAT GO AWAY OUTSIDE", "CO ALARM"]}, {"k": "err", "a": 713.02, "b": 717.22, "n": "!", "tx": "EVERYBODY OUT · 911 FROM OUTSIDE"}, {"k": "step", "a": 727.8, "b": 731.6, "n": "4", "tx": "NO CREDIT CHECK AT THE TABLE"}, {"k": "person", "a": 736.36, "b": 740.36, "name": "EARL WASHINGTON", "l2": "76 · RETIRED CTA DRIVER · AUSTIN"}, {"k": "tag", "a": 763.22, "b": 766.82, "x": 1060, "y": 460, "text": "\"COMFORT ADVISOR\"", "sub": "= the salesman", "col": "#ffb257"}, {"k": "money", "a": 776.54, "b": 779.94, "to": 189, "label": "A MONTH · \"ZERO PERCENT\"", "col": "#ffd60a", "from": 0}, {"k": "comment", "a": 794.2, "b": 798.8, "text": "\"Son. I drove a bus on Madison Street for thirty-one years. I know every hustle there is.\""}, {"k": "stamp", "a": 796.3, "b": 799.1, "text": "\"BETTER THAN YOU.\"", "col": "#ffd60a", "rot": -4}, {"k": "chips", "a": 804.04, "b": 808.64, "items": ["A REAL CREDIT CHECK", "A MARK ON YOUR REPORT", "\"YOU QUALIFY\""]}, {"k": "big", "a": 820.32, "b": 823.12, "text": "A LOAN", "sub": "you came for a repair", "col": "#ff4a3d"}, {"k": "stamp", "a": 830.06, "b": 833.06, "text": "DEFERRED INTEREST", "col": "#ff4a3d", "rot": -4}, {"k": "chips", "a": 839.16, "b": 844.76, "items": ["$1 LEFT AT THE END", "→ ALL THE INTEREST", "BACK TO DAY ONE", "25-27 %"]}, {"k": "money", "a": 857.52, "b": 860.92, "to": 2000, "label": "INTEREST · BERWYN WIDOW", "col": "#ff4a3d", "from": 0}, {"k": "chips", "a": 863.38, "b": 868.98, "items": ["NO SOCIAL SECURITY #", "NO DATE OF BIRTH", "NO DRIVER'S LICENSE PICTURE"]}, {"k": "fridge", "a": 880.32, "b": 884.92, "text": "\"I don't do finances on the first visit. Leave me the paper.\""}, {"k": "stamp", "a": 893.9, "b": 896.9, "text": "\"WE'LL CALL YOU.\"", "col": "#3fd17a", "rot": -4}, {"k": "step", "a": 900.76, "b": 904.56, "n": "5", "tx": "NEVER THE SAME DAY"}, {"k": "chips", "a": 909.9, "b": 914.9, "items": ["BASEMENT", "OLD PART", "SAFETY", "CREDIT", "→ TODAY"]}, {"k": "comment", "a": 930.54, "b": 933.94, "text": "\"Ma, why didn't you get another price?\""}, {"k": "fridge", "a": 953.04, "b": 958.04, "text": "NOTHING GETS SIGNED AT THE CUSTOMER'S TABLE.  — Rosa, 1986"}, {"k": "timer", "a": 962.78, "b": 965.98, "label": "24 HOURS", "sub": "and a second price"}, {"k": "stamp", "a": 967.74, "b": 970.74, "text": "STILL GOOD THURSDAY", "col": "#3fd17a", "rot": -4}, {"k": "chips", "a": 974.16, "b": 979.76, "items": ["\"CARBON MONOXIDE\"", "\"CRACK\"", "\"I CAN'T LEGALLY...\""]}, {"k": "chips", "a": 999.32, "b": 1004.32, "items": ["EMERGENCY = MAKE IT SAFE", "≠ BUY A FURNACE IN 40 MIN"]}, {"k": "big", "a": 1017.6, "b": 1019.7, "text": "THE RIGHT SOMEONE", "sub": "not just someone", "col": "#ffd60a"}, {"k": "person", "a": 1019.84, "b": 1023.84, "name": "HELEN DOMBROWSKI", "l2": "81 · NORRIDGE · THE 1987 FURNACE"}, {"k": "chips", "a": 1028.92, "b": 1034.12, "items": ["$7,800", "$9,400", "$11,200"]}, {"k": "map", "a": 1037.6, "b": 1045.6, "pins": [{"at": 1041.06, "k": "SCHAUMBURG", "sub": "GARY & KAREN"}, {"at": 1044.0, "k": "NORRIDGE", "sub": "HELEN"}]}, {"k": "comment", "a": 1045.72, "b": 1049.12, "text": "\"Ma, sign it. It's your life.\""}, {"k": "comment", "a": 1088.88, "b": 1094.48, "text": "\"Gary. Whoever covers up my Enzo doesn't come down to my basement anymore. Not the company. Not you.\""}, {"k": "stamp", "a": 1093.26, "b": 1095.86, "text": "NOT YOU.", "col": "#ff4a3d", "rot": -5, "y": 330}, {"k": "big", "a": 1095.8, "b": 1098.4, "text": "3 WEEKS", "sub": "no Sunday dinner", "col": "#ffb257"}, {"k": "comment", "a": 1105.78, "b": 1110.38, "text": "\"I was married forty-nine years to a mailman. I know when a man is carrying something that isn't his.\""}, {"k": "stamp", "a": 1123.38, "b": 1126.38, "text": "CAN WAIT ONE DAY", "col": "#3fd17a", "rot": -4}, {"k": "comment", "a": 1134.32, "b": 1138.12, "text": "\"Enzo. Write me something I can tape on the basement door.\""}, {"k": "recap", "a": 1142.58, "b": 1153.58, "rows": [{"at": 1142.78, "tx": "I LIKE TO WATCH."}, {"at": 1144.16, "tx": "I WANT THE OLD PART."}, {"at": 1145.82, "tx": "NO JUMPERS."}, {"at": 1147.0, "tx": "NO SOCIAL SECURITY AT THE TABLE."}, {"at": 1149.36, "tx": "NOTHING SIGNED TODAY."}, {"at": 1150.8, "tx": "SHOW ME THE READING."}]}, {"k": "qr", "a": 1161.28, "b": 1173.28, "page": "pg_sign_cap6", "name": "DON'T BUY THAT FURNACE", "pg": "BOOK 1 · \"NEVER SIGN UNTIL YOU ASK THIS\""}, {"k": "step", "a": 1200.12, "b": 1203.92, "n": "6", "tx": "A SALESMAN CALLED A TECHNICIAN"}, {"k": "comment", "a": 1215.5, "b": 1219.3, "text": "\"Enzo, if you tell people the truth about everybody, you tell them the truth about us too.\""}, {"k": "chips", "a": 1237.24, "b": 1242.24, "items": ["\"COMFORT ADVISOR\"", "\"HOME COMFORT CONSULTANT\"", "\"SYSTEM SPECIALIST\""]}, {"k": "stamp", "a": 1242.2, "b": 1244.8, "text": "A SALESMAN", "col": "#ff4a3d", "rot": -4}, {"k": "big", "a": 1253.58, "b": 1256.38, "text": "COMMISSION", "sub": "no sale, no commission", "col": "#ffb257"}, {"k": "stamp", "a": 1263.44, "b": 1266.24, "text": "A LEAD IS YOU", "col": "#ff4a3d", "rot": -5}, {"k": "comment", "a": 1273.82, "b": 1278.02, "text": "\"Mrs. So-and-so on Lawrence. 22-year-old furnace. Scared. Widow.\""}, {"k": "money", "a": 1278.56, "b": 1281.76, "to": 100, "label": "PER LEAD", "col": "#ff4a3d", "from": 0}, {"k": "fridge", "a": 1287.76, "b": 1294.16, "text": "1 · \"Will a technician come, or a salesman?\"   2 · \"Are your techs paid commission or bonuses on what they sell?\""}, {"k": "chips", "a": 1307.22, "b": 1311.82, "items": ["$12 FIX = SAME PAY", "NEW FURNACE = SAME PAY"]}, {"k": "comment", "a": 1324.42, "b": 1329.42, "text": "\"The day you get paid for what you sell, you stop hearing the furnace and you start hearing the cash register.\""}, {"k": "person", "a": 1337.2, "b": 1339.4, "name": "KYLE", "l2": "THE SALESMAN · HIRED BY MARCO, 2022"}, {"k": "map", "a": 1339.48, "b": 1343.48, "pins": [{"at": 1343.02, "k": "BELMONT-CRAGIN", "sub": "KYLE · 19"}]}, {"k": "stamp", "a": 1356.82, "b": 1359.82, "text": "THE EXACT THING", "col": "#ffb257", "rot": -4}, {"k": "big", "a": 1369.38, "b": 1372.18, "text": "2×", "sub": "on commission", "col": "#ff4a3d"}, {"k": "comment", "a": 1376.24, "b": 1379.64, "text": "\"Then he made the choice. That's on him.\""}, {"k": "comment", "a": 1386.86, "b": 1389.86, "text": "\"Pop. There's something else.\""}, {"k": "person", "a": 1392.44, "b": 1396.04, "name": "BRAD", "l2": "\"HOME COMFORT CONSULTANT\" · SPRING"}, {"k": "chips", "a": 1404.56, "b": 1409.36, "items": ["$50 PER LEAD", "MORE IF BRAD SELLS"]}, {"k": "person", "a": 1419.9, "b": 1423.5, "name": "FATHER MIKE", "l2": "ST. ROSALIE · THE BOILER"}, {"k": "stamp", "a": 1448.38, "b": 1451.78, "text": "\"YOUR OPINION, OR HIS?\"", "col": "#ffd60a", "rot": -4}, {"k": "comment", "a": 1459.74, "b": 1463.14, "text": "\"You put a cash register in my boys' ears.\""}, {"k": "chips", "a": 1467.06, "b": 1472.66, "items": ["INSURANCE ON THE TRUCKS", "RENT ON HARLEM AVE", "BIG COMPANIES PAY DOUBLE"]}, {"k": "comment", "a": 1486.22, "b": 1489.82, "text": "\"You had it easy. You had Mom doing the books for free.\""}, {"k": "stamp", "a": 1538.86, "b": 1541.66, "text": "ASK US TOO", "col": "#ffd60a", "rot": -4}, {"k": "big", "a": 1551.72, "b": 1554.52, "text": "IF THEY GET QUIET", "sub": "now you know something", "col": "#ffb257"}, {"k": "money", "a": 1568.76, "b": 1571.76, "to": 40, "label": "FATHER MIKE'S BOILER", "col": "#3fd17a", "from": 0}, {"k": "recap", "a": 1584.6, "b": 1644.6, "rows": [{"at": 1584.6, "tx": "NEVER ALONE IN THE BASEMENT · TAKE PICTURES"}, {"at": 1590.96, "tx": "KEEP THE OLD PART · PAY BY CREDIT CARD"}, {"at": 1597.92, "tx": "NO JUMPERS · NOT EVEN \"JUST FOR TONIGHT\""}, {"at": 1607.64, "tx": "NO SOCIAL / BIRTH DATE AT THE TABLE"}, {"at": 1621.76, "tx": "NOTHING SIGNED TODAY · 24 HOURS"}, {"at": 1640.2, "tx": "\"A TECHNICIAN OR A SALESMAN?\""}]}, {"k": "big", "a": 1680.6, "b": 1683.6, "text": "3 BUSINESS DAYS", "sub": "in-home sale · cancel in writing", "col": "#9fd8ff"}, {"k": "fridge", "a": 1695.8, "b": 1702.8, "text": "I like to watch · I want the old part · No jumpers · No Social Security at the table · Nothing signed today · Show me the reading"}, {"k": "chips", "a": 1715.58, "b": 1721.18, "items": ["CARMELA · A NIGHT IN HER COAT", "HELEN · THREE SUNDAYS", "GUS · $1,200"]}, {"k": "comment", "a": 1724.7, "b": 1729.3, "text": "Did a company ever do one of these 6 things in your home? Which one? What did they want to charge?"}, {"k": "next", "a": 1772.36, "b": 1781.36, "title": "Old HVAC Tech: Never Plug a Space Heater Into This", "sub": "SUBSCRIBE · TELL ME WHAT THE COMPANY TOLD YOU"}]