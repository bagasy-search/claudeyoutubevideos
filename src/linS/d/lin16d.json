 1474.7333, "e": 1484.5, "k": "S", "sc": "repaso", "tr": "wipe"}, {"s": 1484.5, "e": 1488.6333, "k": "A", "off": 416.862, "tr": "wipe"}, {"s": 1488.6333, "e": 1498.6, "k": "S", "sc": "repaso", "tr": "wipe"}, {"s": 1498.6, "e": 1503.8, "k": "A", "off": 421.152, "tr": "wipe"}, {"s": 1503.8, "e": 1511.2333, "k": "S", "sc": "repaso", "tr": "wipe"}, {"s": 1511.2333, "e": 1516.3333, "k": "A", "off": 426.502, "tr": "wipe"}, {"s": 1516.3333, "e": 1524.1333, "k": "S", "sc": "repaso", "tr": "wipe"}, {"s": 1524.1333, "e": 1527.0667, "k": "G", "f": "g/g398.png", "tr": "wipe"}, {"s": 1527.0667, "e": 1528.7, "k": "G", "f": "g/g399.png"}, {"s": 1528.7, "e": 1531.5, "k": "A", "off": 431.732}, {"s": 1531.5, "e": 1534.6, "k": "G", "f": "g/g400.png"}, {"s": 1534.6, "e": 1539.1, "k": "A", "off": 434.682}, {"s": 1539.1, "e": 1543.1333, "k": "G", "f": "g/g403.png"}, {"s": 1543.1333, "e": 1544.6667, "k": "A", "off": 439.352}, {"s": 1544.6667, "e": 1549.2, "k": "G", "f": "g/g406.png"}, {"s": 1549.2, "e": 1554.6, "k": "G", "f": "g/g406_with.png"}, {"s": 1554.6, "e": 1557.4333, "k": "G", "f": "g/g407.png"}, {"s": 1557.4333, "e": 1558.9, "k": "A", "off": 441.022}, {"s": 1558.9, "e": 1560.4667, "k": "G", "f": "g/g409.png"}, {"s": 1560.4667, "e": 1565.0333, "k": "A", "off": 442.612}, {"s": 1565.0333, "e": 1569.3, "k": "G", "f": "g/g411.png"}, {"s": 1569.3, "e": 1574.94, "k": "A", "off": 447.343}], "ov": [{"k": "Palabra", "a": 21.6333, "b": 23.5333, "kan": "8 h", "rom": "Detroit to London", "sig": "Gloria's flight"}, {"k": "Lower", "a": 62.9333, "b": 78.1667, "name": "Linda", "sub": "retired flight attendant · 35 years in the aisle"}, {"k": "Kin", "a": 177.7333, "b": 181.0333, "txt": "Toledo · Detroit · London"}, {"k": "Kin", "a": 181.1333, "b": 184.6667, "txt": "Frankfurt", "big": 1}, {"k": "Prueba", "a": 213.1, "b": 226.6667, "txt": "Every pill, pen and inhaler goes in your carry-on.", "lab": "linda's rule"}, {"k": "Kin", "a": 265.7333, "b": 276.0333, "txt": "Denver · a blizzard"}, {"k": "Prueba", "a": 287.3, "b": 305.8667, "txt": "A few extra days, split between two bags.", "lab": "linda's rule"}, {"k": "Prueba", "a": 362.2333, "b": 375.7667, "txt": "A small pouch at your feet. Not in the bin.", "lab": "linda's rule"}, {"k": "Prueba", "a": 449.3667, "b": 472.7667, "txt": "Keep the labels. Abroad, keep the bottles.", "lab": "linda's rule"}, {"k": "Palabra", "a": 499.6333, "b": 504.3, "kan": "3.4 oz", "rom": "the liquids rule", "sig": "medicine: declare it"}, {"k": "Prueba", "a": 570.3, "b": 583.8333, "txt": "Liquid medicine in its own bag. Tell the officer first.", "lab": "linda's rule"}, {"k": "Prueba", "a": 629.5667, "b": 642.4667, "txt": "Ask how warm it may get. A little cool case.", "lab": "linda's rule"}, {"k": "Palabra", "a": 715.8667, "b": 718.2333, "kan": "+5 h", "rom": "London time", "sig": "Toledo is behind", "lado": "izq"}, {"k": "Prueba", "a": 760.6333, "b": 774.8333, "txt": "Ask your doctor: how do I take these across time zones?", "lab": "linda's rule"}, {"k": "Prueba", "a": 849.9, "b": 856.9667, "txt": "Anything new, try it at home first.", "lab": "linda's rule"}, {"k": "Cta", "a": 888.0, "b": 894.1, "txt": "What's the one thing you always keep in your carry-on?"}, {"k": "Prueba", "a": 989.3, "b": 1005.6667, "txt": "One sealed bottle of water, just for your pills.", "lab": "linda's rule"}, {"k": "Prueba", "a": 1069.6333, "b": 1075.2667, "txt": "Only your own medicine, with your name on it.", "lab": "linda's rule"}, {"k": "Kin", "a": 1110.1667, "b": 1113.2333, "txt": "over Greenland"}, {"k": "Prueba", "a": 1176.5667, "b": 1189.2333, "txt": "Write the list. One in your wallet, one in your bag.", "lab": "linda's rule"}, {"k": "Kin", "a": 1288.8, "b": 1292.9, "txt": "everything goes in my purse now", "big": 1}, {"k": "Cta", "a": 1560.6667, "b": 1564.9333, "txt": "Where are you flying next?"}, {"k": "Fin", "a": 1572.7333, "b": 1574.9333, "sub": "fly safe, my friends"}]}