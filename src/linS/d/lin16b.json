s", "big": 1}, {"k": "Prueba", "a": 529.9667, "b": 537.4667, "txt": "Loose shoes. Off for an hour, back on.", "lab": "linda's rule"}, {"k": "Prueba", "a": 651.4, "b": 655.0, "txt": "Never a new pill on the plane. Never with wine.", "lab": "linda's rule"}, {"k": "Prueba", "a": 736.6667, "b": 746.5333, "txt": "Feet flat, legs uncrossed, a pillow behind your back.", "lab": "linda's rule"}, {"k": "Kin", "a": 881.6667, "b": 882.8, "txt": "still walking, Harold", "big": 1}, {"k": "Cta", "a": 898.2, "b": 903.8, "txt": "What's the longest flight you've ever taken?"}, {"k": "Prueba", "a": 911.4333, "b": 917.0667, "txt": "Every hour or two: up the aisle and back.", "lab": "linda's rule"}, {"k": "Palabra", "a": 928.8333, "b": 931.1333, "kan": "10 × 2", "rom": "ankle circles", "sig": "each way, every hour"}, {"k": "Palabra", "a": 931.1333, "b": 934.9, "kan": "20", "rom": "toes up, toes down", "sig": "under the tray table", "lado": "izq"}, {"k": "Prueba", "a": 961.4333, "b": 976.3333, "txt": "Compression socks: ask your doctor first.", "lab": "linda's rule"}, {"k": "Prueba", "a": 991.1667, "b": 999.8333, "txt": "One swollen, sore, warm leg: call a doctor that day.", "lab": "linda's rule"}, {"k": "Prueba", "a": 1121.2, "b": 1129.7333, "txt": "Hand on the seat. Halfway. Wait. Then all the way.", "lab": "linda's rule"}, {"k": "Prueba", "a": 1204.3, "b": 1210.6333, "txt": "Go before the meal, go when the light goes off.", "lab": "linda's rule"}, {"k": "Kin", "a": 1220.4, "b": 1222.9667, "txt": "push the middle"}, {"k": "Prueba", "a": 1280.2333, "b": 1287.0667, "txt": "Chew, swallow, yawn on the way down.", "lab": "linda's rule"}, {"k": "Prueba", "a": 1371.3, "b": 1375.9667, "txt": "When the bell dings, stay sitting.", "lab": "linda's rule"}, {"k": "Prueba", "a": 1399.3333, "b": 1407.0667, "txt": "No long drive the day you land.", "lab": "linda's rule"}, {"k": "Cta", "a": 1671.6333, "b": 1678.1667, "txt": "Where are you flying this winter?"}, {"k": "Fin", "a": 1698.8667, "b": 1701.0667, "sub": "fly safe, my friends"}]}